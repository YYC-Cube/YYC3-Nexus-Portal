# Ollama 服务地址（Standalone / Docker 模式下 /api/chat 使用）
OLLAMA_URL=http://localhost:11434

# Ollama 上游请求超时（毫秒，默认 30000）
OLLAMA_TIMEOUT_MS=30000

# 是否信任反向代理注入的 X-Forwarded-For / X-Real-IP（默认 false）
# 仅当部署在可信反向代理之后设为 true；否则请求头可被客户端伪造以绕过限流
TRUST_PROXY_HEADERS=false

# 构建模式：standalone（默认，含 API 与服务端安全头）| export（GitHub Pages 静态导出）
BUILD_MODE=standalone

# 服务端口（容器内默认 3200）
PORT=3200
